# Use an official Node.js alpine image for a smaller footprint
FROM node:20-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy package files first to leverage Docker layer caching
COPY package.json package-lock.json ./

# Install all dependencies (including devDependencies needed for Vite)
RUN npm install

# Copy the rest of your application code
COPY . .

# Expose Vite's default development port
EXPOSE 5173

# Start the dev server and bind to 0.0.0.0 so it's accessible outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
